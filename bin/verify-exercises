#!/usr/bin/env bash

# Synopsis:
# Verify that each example solution passes the tests.
# By default this runs all non-deprecated practice exercises.
#
# Options:
#   -e, --exercise <slug>   Verify only the given exercise.
#       --validate-output   Validate test-runner output locally.

set -euo pipefail

usage() {
    echo "Usage: $0 [-e|--exercise <slug>] [--validate-output]" >&2
    exit 1
}

exercise_slug=""
validate_output=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -e|--exercise)
            [[ $# -ge 2 ]] || usage
            exercise_slug="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        --validate-output)
            validate_output=true
            shift
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage
            ;;
    esac
done

verify_test_output() {
    guile -c '
      (let ((output (call-with-input-file (cadr (command-line)) read)))
        (unless (and (equal? (assq '\''status output) '\''(status . ok))
                     (let loop ((results (cddr output)))
                       (or (null? results)
                           (and (eq? (caar results) '\''pass) (loop (cdr results))))))
          (display "Invalid or failing test output\n" (current-error-port))
          (exit 1)))
    ' "$1"
}

if [[ -n "${exercise_slug}" ]]; then
    if [[ ! -d "exercises/practice/${exercise_slug}" ]]; then
        echo "No such exercise: ${exercise_slug}" >&2
        exit 1
    fi
    active_exercises=("${exercise_slug}")
else
    # Fetch non-deprecated exercises.
    mapfile -t active_exercises < <(
        jq -r '.exercises.practice[] | select(.status != "deprecated") | .slug' config.json
    )
fi

for exercise in "${active_exercises[@]}"; do
    target_dir="exercises/practice/${exercise}"
    [[ -d "${target_dir}" ]] || continue

    echo "Verifying ${target_dir}..."
    if "${validate_output}"; then
        (
            cd "${target_dir}"
            solution_file="${exercise}.scm"
            backup_file="$(mktemp)"
            output_file="$(mktemp)"
            error_file="$(mktemp)"
            trap 'cp "${backup_file}" "${solution_file}"; rm -f "${backup_file}" "${output_file}" "${error_file}"' EXIT
            cp "${solution_file}" "${backup_file}"
            cp .meta/example.scm "${solution_file}"
            if ! GUILE_AUTO_COMPILE=0 make --silent guile solution=--docker > "${output_file}" 2> "${error_file}"; then
                cat "${error_file}" >&2
                exit 1
            fi
            if ! verify_test_output "${output_file}"; then
                cat "${output_file}" >&2
                exit 1
            fi
        )
    else
        make -C "${target_dir}" guile solution=.meta/example.scm
    fi
done
