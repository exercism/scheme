#!/usr/bin/env bash

# Synopsis:
# Verify that each example solution passes the tests.
# By default this runs all non-deprecated practice exercises.
#
# Options:
#   -e, --exercise <slug>   Verify only the given exercise.

set -euo pipefail

usage() {
    echo "Usage: $0 [-e|--exercise <slug>]" >&2
    exit 1
}

exercise_slug=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -e|--exercise)
            [[ $# -ge 2 ]] || usage
            exercise_slug="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage
            ;;
    esac
done

if [[ -n "${exercise_slug}" ]]; then
    if [[ ! -d "exercises/practice/${exercise_slug}" ]]; then
        echo "No such exercise: ${exercise_slug}" >&2
        exit 1
    fi
    active_exercises=("${exercise_slug}")
else
    # Fetch non-deprecated exercises. Acronym is excluded since it's Guile-only.
    mapfile -t active_exercises < <(
        jq -r '.exercises.practice[] | select(.status != "deprecated" and .slug != "acronym") | .slug' config.json
    )
fi

for exercise in "${active_exercises[@]}"; do
    target_dir="exercises/practice/${exercise}"
    [[ -d "${target_dir}" ]] || continue

    echo "Verifying ${target_dir}..."
    make -C "${target_dir}" chez solution=.meta/example.scm
done
