{{ header }}

(load "test-util.ss")

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
        equal? {{ case["property"] }} '({{ case["input"]["phrase"] | tojson }})
        {{ case["expected"] | tojson }})
{% endfor %}    ))

(run-with-cli "{{ name }}.scm" (list test-cases))
