{{ header }}

(load "test-util.ss")

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
        eq? attacking? '(({{ case.input.white_queen.position.row }} {{ case.input.white_queen.position.column }}) ({{ case.input.black_queen.position.row }} {{ case.input.black_queen.position.column }})) {{ case["expected"] }}){% if not loop.last %}
{% endif %}{% endfor %}))

(run-with-cli "{{ name }}.scm" (list test-cases))
