{{ header }}

(load "test-util.ss")

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
        eq? pangram? '("{{ case["input"]["sentence"] | replace('"', '\\"') }}") {{ case["expected"] }})
{% endfor %}    ))

(run-with-cli "{{ name }}.scm" (list test-cases))
