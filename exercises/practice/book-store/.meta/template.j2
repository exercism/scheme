{{ header }}

(load "test-util.ss")

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
        = total '{{ case["input"]["basket"] | format_list }}
        {{ case["expected"] }})
{%- endfor %}
    ))

(run-with-cli "{{ name }}.scm" (list test-cases))
