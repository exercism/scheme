{{ header }}

(load "test-util.ss")

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
        = score '({{ case["input"]["category"] | replace(" ", "-") }} #{{ case["input"]["dice"] | format_list }})
        {{ case["expected"] }})
{%- endfor %}
    ))

(run-with-cli "{{ name }}.scm" (list test-cases))
