{{ header }}

(load "test-util.ss")

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
        equal? pascals-triangle '({{ case["input"]["count"] }}) '{{ case["expected"] | format_list }})
{% endfor %}    ))

(run-with-cli "{{ name }}.scm" (list test-cases))
