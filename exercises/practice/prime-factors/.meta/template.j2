{{ header }}

(load "test-util.ss")

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
        (lambda (xs ys) (equal? (list-sort < xs) (list-sort < ys)))
        factorize '({{ case["input"]["value"] }}) '{{ case["expected"] | format_list }})
{% endfor %}    ))

(run-with-cli "{{ name }}.scm" (list test-cases))
