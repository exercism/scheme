{{ header }}

(load "test-util.ss")

; Compare lists of factors ignoring order.
(define (sorted-equal? xs ys)
  (equal? (list-sort < xs) (list-sort < ys)))

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
        sorted-equal? factorize '({{ case["input"]["value"] }}) '{{ case["expected"] | format_list }})
{% endfor %}    ))

(run-with-cli "{{ name }}.scm" (list test-cases))
