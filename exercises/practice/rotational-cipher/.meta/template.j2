{{ header }}

(load "test-util.ss")

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
        equal? rotate '({{ case["input"]["text"] | tojson }} {{ case["input"]["shiftKey"] }})
        {{ case["expected"] | tojson }})
{% endfor %}    ))

(run-with-cli "{{ name }}.scm" (list test-cases))
