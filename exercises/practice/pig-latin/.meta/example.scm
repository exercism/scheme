(import (rnrs))

(define (mid-index phrase index)
  (let* ((phrase-len (string-length phrase))
         (first (string-ref phrase index)))
    (if (or (char=? first #\a)
            (char=? first #\e)
            (char=? first #\i)
            (char=? first #\o)
            (char=? first #\u)
            (and (char=? first #\x)
                 (< (+ index 1) phrase-len)
                 (char=? (string-ref phrase (+ index 1)) #\r))
            (and (char=? first #\y)
                 (< (+ index 1) phrase-len)
                 (char=? (string-ref phrase (+ index 1)) #\t)))
        index
        (let loop ((index (+ index 1)))
          (if (= index phrase-len)
              index
              (let ((ch (string-ref phrase index)))
                (if (or (char=? ch #\a)
                        (char=? ch #\e)
                        (char=? ch #\i)
                        (char=? ch #\o)
                        (char=? ch #\u)
                        (char=? ch #\y)
                        (char=? ch #\space))
                    (if (and (char=? ch #\u) (char=? (string-ref phrase (- index 1)) #\q))
                        (+ index 1)
                        index)
                    (loop (+ index 1)))))))))

(define (end-index phrase mid)
  (let ((phrase-len (string-length phrase)))
    (let loop ((end mid))
      (cond
        ((= end phrase-len) end)
        ((char=? #\space (string-ref phrase end)) end)
        (else (loop (+ end 1)))))))

(define (translate phrase)
  (let ((phrase-len (string-length phrase)))
    (let loop ((index 0)
               (result ""))
      (if (<= phrase-len index)
          result
          (let* ((mid (mid-index phrase index))
                 (end (end-index phrase mid))
                 (suffix (if (= end phrase-len) "ay" "ay ")))
            (loop (+ end 1)
                  (string-append result
                                 (substring phrase mid end)
                                 (substring phrase index mid)
                                 suffix)))))))
