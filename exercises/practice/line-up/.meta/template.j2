{{ header }}

(load "test-util.ss")

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
        string=? format '("{{ case["input"]["name"] }}" {{ case["input"]["number"] }})
        "{{ case["expected"] }}")
{%- endfor %}
    ))

(run-with-cli "{{ name }}.scm" (list test-cases))
