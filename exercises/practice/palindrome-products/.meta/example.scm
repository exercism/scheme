(import (rnrs))

(define (palindrome? num)
  (cond
    ((zero? num) #t)
    ((zero? (remainder num 10)) #f)
    (else
     (let loop ((p num)
                (q 0))
       (if (< q p)
           (loop (quotient p 10) (+ (* q 10) (remainder p 10)))
           (or (= q p) (= (quotient q 10) p)))))))

(define (smallest min-factor max-factor)
  (when (< max-factor min-factor)
    (error 'smallest "min-factor must be <= max-factor" min-factor max-factor))
  (let outer ((product (+ (* max-factor max-factor) 1))
              (factors '())
              (i min-factor))
    (if (or (< max-factor i) (< product (* i i)))
        (values (if (null? factors) #f product) (reverse factors))
        (let inner ((j i))
          (let ((ij (* i j)))
            (cond
              ((< max-factor j)
               (outer product factors (+ i 1)))
              ((< product ij)
               (outer product factors (+ i 1)))
              ((not (palindrome? ij))
               (inner (+ j 1)))
              ((= ij product)
               (outer product (cons (list i j) factors) (+ i 1)))
              (else
               (outer ij (list (list i j)) (+ i 1)))))))))

(define (largest min-factor max-factor)
  (when (< max-factor min-factor)
    (error 'largest "min-factor must be <= max-factor" min-factor max-factor))
  (let outer ((product (- (* min-factor min-factor) 1))
              (factors '())
              (j max-factor))
    (if (or (< j min-factor) (< (* j j) product))
        (values (if (null? factors) #f product) (reverse factors))
        (let inner ((i j))
          (let ((ij (* i j)))
            (cond
              ((< i min-factor)
               (outer product factors (- j 1)))
              ((< ij product)
               (outer product factors (- j 1)))
              ((not (palindrome? ij))
               (inner (- i 1)))
              ((= ij product)
               (outer product (cons (list i j) factors) (- j 1)))
              (else
               (outer ij (list (list i j)) (- j 1)))))))))
