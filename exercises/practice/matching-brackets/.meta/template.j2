{{ header }}

(load "test-util.ss")

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
      {# need to handle backslashes in "20. complex latex expression" -#}
        eq? balanced? '("{{ case["input"]["value"] | replace("\\", "\\\\") }}") {{ case["expected"] }})
{% endfor %}    ))

(run-with-cli "{{ name }}.scm" (list test-cases))
