(import (rnrs))

(define (parity number)
  (let loop ((number number)
             (acc 0))
    (if (zero? number)
      (remainder acc 2)
      (loop (quotient number 2) (+ acc (remainder number 2))))))

(define (transmit number)
  (let ((number (remainder number 128)))
    (+ (ash number 1) (parity number))))

(define (transmit-sequence message)
  (let loop ((message message)
             (result '())
             (count 0)
             (pending 0))
    (if (null? message)
      (reverse result)
      (let* ((byte (car message))
             (message (cdr message))
             (pending (+ (ash (remainder pending 64) 8) byte))
             (count (+ count 1))
             (result (cons (transmit (ash pending (- count))) result))
             (adjustment (if (null? message) (- 7 count) 0)))
        (let ((pending (ash pending adjustment))
              (count (+ count adjustment)))
          (if (= count 7)
            (loop message (cons (transmit pending) result) 0 0)
            (loop message result count pending)))))))

(define (decode-message message)
  (let loop ((message message)
             (result '())
             (count 0)
             (pending 0))
    (if (null? message)
      (reverse result)
      (let ((byte (car message))
            (message (cdr message)))
        (if (zero? (parity byte))
          (let ((pending (+ (ash (remainder pending 128) 7) (ash byte -1)))
                (count (+ count 7)))
            (if (<= 8 count)
              (loop message (cons (remainder (ash pending (- 8 count)) 256) result) (- count 8) pending)
              (loop message result count pending)))
          (error 'decode-message "wrong parity" byte))))))
