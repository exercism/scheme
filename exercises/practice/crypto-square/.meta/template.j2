{{ header }}

(load "test-util.ss")

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
        string=? encipher '("{{ case["input"]["plaintext"] }}")
        "{{ case["expected"] }}")
{% endfor %}    ))

(run-with-cli "{{ name }}.scm" (list test-cases))
