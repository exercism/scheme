{{ header }}

(load "test-util.ss")

(define test-cases
  `(
{%- for case in cases %}
    (test-success "{{ loop.index }}. {{ case["description"] }}"
        equal? rows '(#\{{ case["input"]["letter"] }})
        '(
{%- for row in case["expected"] %}"{{ row }}"{% if not loop.last %}
          {% endif %}{% endfor %})){% if not loop.last %}
{% endif %}{% endfor %}))

(run-with-cli "{{ name }}.scm" (list test-cases))
